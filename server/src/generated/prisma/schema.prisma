generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ActiveProtocolStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum WishlistOwnerType {
  ORG
  FOSTER
  KITTEN
}

enum WishlistRetailer {
  AMAZON
  CHEWY
  WALMART
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  // Claimed by the scheduler and mid-publish. Exists so a claim is visible to
  // every serverless instance: only a SCHEDULED -> PUBLISHING transition can
  // succeed, so overlapping cron runs cannot both publish the same post.
  PUBLISHING
  POSTED
  FAILED
}

enum DoseStatus {
  SCHEDULED
  MISSED
  GIVEN
}

enum ProtocolCadence {
  DAILY
  EVERY_N_DAYS
  WEEKLY
  MONTHLY
}

enum ProtocolRecordType {
  NONE
  MEDICATION
  VACCINE
}

enum ProtocolHealthWriteMode {
  PER_DOSE
  COURSE
}

model Litter {
  id         Int       @id @default(autoincrement())
  name       String
  intakeDate DateTime?
  notes      String    @default("")
  isActive   Boolean   @default(true)
  kittens    Kitten[]
}

model Foster {
  id                  Int          @id @default(autoincrement())
  name                String
  phone               String
  email               String
  address             String
  emergencyContact    String       @default("")
  experienceLevel     String       @default("")
  capabilityFlags     String       @default("")
  maxKittens          Int          @default(0)
  photoUrl            String?
  notes               String       @default("")
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  currentKittens      Kitten[]     @relation("CurrentFoster")
  placements          Placement[]
  contracts           Contract[]
  portalUser          User?
  submittedDocuments  Document[]   @relation("DocumentSubmittedByFoster")
  sourceApplicationId Int?
  sourceApplication   Application? @relation(fields: [sourceApplicationId], references: [id], onDelete: SetNull)
}

model Kitten {
  id                     Int              @id @default(autoincrement())
  name                   String
  litterId               Int?
  litter                 Litter?          @relation(fields: [litterId], references: [id], onDelete: SetNull)
  status                 String           @default("In Foster Care")
  rescueStory            String           @default("")
  dateOfBirth            DateTime?
  sex                    String           @default("")
  fixedStatus            String           @default("")
  breed                  String
  color                  String           @default("")
  coatPattern            String           @default("")
  fivFelvStatus          String?
  specialNeeds           String?
  microchipNumber        String           @default("")
  primaryPhotoUrl        String?
  thumbnailUrl           String?
  intakeDate             DateTime?
  intakeSource           String           @default("")
  // Outcome fields: date for Adopted/Deceased/Released; detail text for Transferred.
  outcomeDate            DateTime?
  outcomeDetail          String?
  notes                  String           @default("")
  internalNotes          String           @default("")
  isListedOnWebsite      Boolean          @default(false)
  websiteFeaturedComment String           @default("")
  publishTargets         String[]         @default([])
  isBondedPair           Boolean          @default(false)
  bondedWithKittenId     Int?
  bondedWithKitten       Kitten?          @relation("KittenBondedPair", fields: [bondedWithKittenId], references: [id], onDelete: SetNull)
  bondedPartners         Kitten[]         @relation("KittenBondedPair")
  bondedWithName         String           @default("")
  isMedicalSpecialNeeds  Boolean          @default(false)
  isTnr                  Boolean          @default(false)
  isColony               Boolean          @default(false)
  currentFosterId        Int?
  currentFoster          Foster?          @relation("CurrentFoster", fields: [currentFosterId], references: [id], onDelete: SetNull)
  createdAt              DateTime         @default(now())
  placements             Placement[]
  weightLogs             WeightLog[]
  vaccines               Vaccine[]
  medications            Medication[]
  vetAppointments        VetAppointment[]
  documents              Document[]
  sponsorships           Sponsorship[]
  updates                Update[]
  transactions           Transaction[]
  contracts              Contract[]
  activeProtocols        ActiveProtocol[]
  eventCats              EventCats[]

  @@index([status])
  @@index([litterId])
  @@index([currentFosterId])
  @@index([status, createdAt])
}

model Update {
  id                Int      @id @default(autoincrement())
  kittenId          Int
  kitten            Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  content           String
  isPublic          Boolean  @default(false)
  platformList      String   @default("")
  publishTargets    String[] @default([])
  socialDeliveryLog String   @default("")
  createdAt         DateTime @default(now())

  @@index([kittenId])
  @@index([kittenId, createdAt])
}

model Sponsorship {
  id          Int      @id @default(autoincrement())
  kittenId    Int
  kitten      Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  sponsorName String
  amount      Float
  tier        String
  createdAt   DateTime @default(now())

  @@index([kittenId])
}

model Placement {
  id            Int       @id @default(autoincrement())
  kittenId      Int
  kitten        Kitten    @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  fosterId      Int
  foster        Foster    @relation(fields: [fosterId], references: [id], onDelete: Restrict)
  intakeDate    DateTime
  dischargeDate DateTime?
  dischargeType String?
  notes         String    @default("")

  @@index([kittenId])
  @@index([fosterId])
}

model WeightLog {
  id          Int      @id @default(autoincrement())
  kittenId    Int
  kitten      Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  date        DateTime
  weightOz    Float    @default(0)
  weightGrams Float    @default(0)
  loggedBy    String   @default("")
  notes       String   @default("")

  @@index([kittenId, date])
}

model Vaccine {
  id             Int            @id @default(autoincrement())
  kittenId       Int
  kitten         Kitten         @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  type           String
  dateGiven      DateTime
  nextDueDate    DateTime?
  lotNumber      String         @default("")
  manufacturer   String         @default("")
  administeredBy String         @default("")
  notes          String         @default("")
  protocolDoses  ProtocolDose[]

  @@index([kittenId])
  @@index([nextDueDate])
}

model Medication {
  id                Int                      @id @default(autoincrement())
  kittenId          Int
  kitten            Kitten                   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  name              String
  dose              String                   @default("")
  frequency         String                   @default("")
  route             String                   @default("")
  condition         String                   @default("")
  startDate         DateTime
  endDate           DateTime?
  status            String                   @default("Active")
  notes             String                   @default("")
  protocolDoses     ProtocolDose[]
  protocolDrugLinks ActiveProtocolDrugLink[]

  @@index([kittenId])
  @@index([status, endDate])
}

model VetAppointment {
  id           Int       @id @default(autoincrement())
  kittenId     Int
  kitten       Kitten    @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  date         DateTime
  clinic       String    @default("")
  vetName      String    @default("")
  reason       String    @default("")
  apptType     String    @default("")
  diagnosis    String    @default("")
  treatment    String    @default("")
  followUpDate DateTime?
  notes        String    @default("")

  @@index([kittenId])
  @@index([date])
}

enum DocumentKind {
  PHOTO
  FILE
}

model Document {
  id                  Int          @id @default(autoincrement())
  kittenId            Int
  kitten              Kitten       @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  fileName            String
  fileUrl             String
  docType             String       @default("")
  description         String       @default("")
  kind                DocumentKind @default(FILE)
  isPrimaryPhoto      Boolean      @default(false)
  sortOrder           Int          @default(0)
  uploadedAt          DateTime     @default(now())
  // Set only when a Foster Portal account uploaded this document via
  // POST /api/portal/kittens/:kittenId/documents - null for every staff
  // upload (documentController.js never sets this). NOT YET MIGRATED as of
  // this write - schema.prisma has the field, but the DB column does not
  // exist until `prisma migrate dev` (or equivalent) is run. Every read/write
  // path in portalDataController.js that touches this field will fail
  // against the live DB until that migration is applied.
  submittedByFosterId Int?
  submittedByFoster   Foster?      @relation("DocumentSubmittedByFoster", fields: [submittedByFosterId], references: [id], onDelete: SetNull)

  @@index([kittenId])
  @@index([kittenId, isPrimaryPhoto])
  @@index([kittenId, kind])
}

model Application {
  id                       Int                 @id @default(autoincrement())
  type                     String
  status                   String              @default("New")
  statusNotes              String              @default("")
  statusUpdatedAt          DateTime?
  kittenOfInterest         String?
  kittenStatusAtSubmission String?
  formData                 String              @default("{}")
  rejectionReason          String?
  rejectionNotes           String?
  rejectedById             Int?
  rejectedAt               DateTime?
  rejectedBy               User?               @relation("ApplicationRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  createdAt                DateTime            @default(now())
  contracts                Contract[]
  uploads                  ApplicationUpload[]
  sourcedFosters           Foster[]

  @@index([rejectedById])
  @@index([status, createdAt])
}

enum ContractType {
  FOSTER
  ADOPTION
}

enum ContractStatus {
  CREATED
  SENT
  SIGNED
  VOID
}

model ContractTemplate {
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  type      ContractType
  label     String
  version   String       @default("2026.1")
  bodyText  String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type])
}

model Contract {
  id                       Int                               @id @default(autoincrement())
  type                     ContractType
  templateSlug             String                            @default("foster_supplies_provided")
  signerName               String
  signerEmail              String
  signerAddress            String                            @default("")
  signerPhone              String                            @default("")
  microchipNumber          String                            @default("")
  kittenName               String                            @default("")
  kittenId                 Int?
  kitten                   Kitten?                           @relation(fields: [kittenId], references: [id], onDelete: SetNull)
  fosterId                 Int?
  foster                   Foster?                           @relation(fields: [fosterId], references: [id], onDelete: SetNull)
  applicationId            Int?
  application              Application?                      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  // Foster Care Agreement only - not used on Adoption contracts. Entered
  // fresh at draft time; intentionally not auto-filled from Foster.emergencyContact
  // (that field is a single free-text blob, not split into name/phone).
  emergencyContactName     String                            @default("")
  emergencyContactPhone    String                            @default("")
  householdAcknowledgments ContractHouseholdAcknowledgment[]
  documentVersion          String
  // Deprecated: legacy signature-image storage, pre-dates signatureImageUrl.
  // Left populated on old rows for backward compatibility; no longer written to.
  signedPdfUrl             String                            @default("")
  signatureAudit           String                            @default("{}")
  signatureImageUrl        String?
  signerNameAtSigning      String?
  signedIpAddress          String?
  frozenAgreementText      String?                           @db.Text
  pdfUrl                   String?
  status                   ContractStatus                    @default(CREATED)
  signedAt                 DateTime?
  // Opaque token for public electronic signing via /sign/:token (emailed to signer).
  signingToken             String?                           @unique
  signingTokenExpiresAt    DateTime?
  createdAt                DateTime                          @default(now())

  @@index([applicationId])
  @@index([fosterId])
  @@index([kittenId])
  @@index([kittenName])
  @@index([status])
  @@index([signerEmail])
  @@index([signedAt])
  @@index([createdAt])
  @@index([templateSlug])
}

// Adult household member acknowledgment signatures for Foster Care
// Agreements only (the document has two separate signature lines for this,
// distinct from the main foster's own signature on Contract). These are
// acknowledgments, not the primary signer: no IP capture, no name
// confirmation, no signatureAudit merge - just name + signature image +
// timestamp, optional (not every foster household has a second adult).
// Only ever created at signing time, alongside the main signature.
model ContractHouseholdAcknowledgment {
  id                Int       @id @default(autoincrement())
  contractId        Int
  contract          Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name              String
  signatureImageUrl String?
  signedAt          DateTime?
  createdAt         DateTime  @default(now())

  @@index([contractId])
}

enum FosterOnboardingStatus {
  APPLIED
  SCREENING
  APPROVED
  ACTIVE
  DECLINED
  WITHDRAWN
}

model FosterOnboarding {
  id             Int                    @id @default(autoincrement())
  applicantName  String
  applicantEmail String
  status         FosterOnboardingStatus @default(APPLIED)
  notes          String                 @default("")
  createdAt      DateTime               @default(now())
  checklistItems OnboardingChecklist[]

  @@index([status])
  @@index([applicantEmail])
}

model OnboardingChecklist {
  id              Int              @id @default(autoincrement())
  onboardingId    Int
  onboarding      FosterOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  stepKey         String
  label           String
  isComplete      Boolean          @default(false)
  completedAt     DateTime?
  completedBy     Int?
  completedByUser User?            @relation("ChecklistCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)

  @@unique([onboardingId, stepKey])
  @@index([onboardingId])
  @@index([completedBy])
}

model ApplicationUpload {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String      @default("")
  docLabel      String      @default("")
  fileUrl       String
  fileType      String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model Content {
  id             Int                 @id @default(autoincrement())
  title          String
  slug           String              @unique
  body           String              @default("")
  category       String              @default("education")
  isRequired     Boolean             @default(false)
  publishTargets String[]            @default([])
  createdAt      DateTime            @default(now())
  completions    ContentCompletion[]

  @@index([category])
}

model ContentCompletion {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId   Int
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

model Event {
  id              Int         @id @default(autoincrement())
  title           String
  slug            String      @unique
  date            DateTime
  endDate         DateTime?
  location        String      @default("")
  description     String      @default("")
  imageUrl        String?
  isPublic        Boolean     @default(false)
  status          String      @default("DRAFT")
  internalNotes   String?
  publishTargets  String[]    @default([])
  // When true (and the event is tagged to kitten(s) via EventCats, and its
  // date falls within the dashboard's rolling 7-day Pacific window), the
  // event surfaces as a clickable reminder on the admin Dashboard.
  showInReminders Boolean     @default(false)
  eventCats       EventCats[]
  rsvps           EventRSVP[]

  @@index([isPublic, status, date])
}

model EventRSVP {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model EventCats {
  id       Int      @id @default(autoincrement())
  eventId  Int
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kittenId Int
  kitten   Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())
  notes    String?

  @@unique([eventId, kittenId])
  @@index([eventId])
  @@index([kittenId])
}

model Role {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  description  String           @default("")
  isSystem     Boolean          @default(false)
  isPortalRole Boolean          @default(false)
  createdAt    DateTime         @default(now())
  users        User[]
  permissions  RolePermission[]
}

model Permission {
  id     Int              @id @default(autoincrement())
  key    String           @unique
  label  String
  module String           @default("")
  roles  RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                        Int                   @id @default(autoincrement())
  email                     String                @unique
  passwordHash              String
  firstName                 String
  lastName                  String
  isActive                  Boolean               @default(true)
  roleId                    Int
  role                      Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  fosterId                  Int?                  @unique
  foster                    Foster?               @relation(fields: [fosterId], references: [id], onDelete: SetNull)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  lastLoginAt               DateTime?
  rejectedApplications      Application[]         @relation("ApplicationRejectedBy")
  completedChecklistItems   OnboardingChecklist[] @relation("ChecklistCompletedBy")
  contentCompletions        ContentCompletion[]
  activatedProtocols        ActiveProtocol[]      @relation("ProtocolActivatedBy")
  administeredProtocolDoses ProtocolDose[]        @relation("ProtocolDoseAdministeredBy")
  passwordResetTokens       PasswordResetToken[]
}

model PasswordResetToken {
  id        Int                  @id @default(autoincrement())
  userId    Int
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String               @unique
  purpose   PasswordTokenPurpose @default(SETUP)
  expiresAt DateTime
  usedAt    DateTime?
  createdIp String?
  usedIp    String?
  createdAt DateTime             @default(now())

  @@index([userId])
}

enum PasswordTokenPurpose {
  SETUP
  RESET
}

model Protocol {
  id              Int              @id @default(autoincrement())
  name            String
  description     String           @default("")
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  drugs           ProtocolDrug[]
  activeProtocols ActiveProtocol[]
}

model ProtocolDrug {
  id                      Int                      @id @default(autoincrement())
  protocolId              Int
  protocol                Protocol                 @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  drugName                String
  dosage                  String                   @default("")
  route                   String                   @default("")
  startDayOffset          Int
  endDayOffset            Int
  frequencyPerDay         Int
  cadence                 ProtocolCadence          @default(DAILY)
  intervalDays            Int                      @default(1) // EVERY_N_DAYS only
  recordType              ProtocolRecordType       @default(NONE)
  healthWriteMode         ProtocolHealthWriteMode  @default(PER_DOSE)
  instructions            String                   @default("")
  sortOrder               Int                      @default(0)
  doses                   ProtocolDose[]
  activeProtocolDrugLinks ActiveProtocolDrugLink[]

  @@index([protocolId])
}

model ActiveProtocol {
  id             Int                      @id @default(autoincrement())
  protocolId     Int
  protocol       Protocol                 @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  kittenId       Int
  kitten         Kitten                   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  activatedById  Int
  activatedBy    User                     @relation("ProtocolActivatedBy", fields: [activatedById], references: [id], onDelete: Restrict)
  activationDate DateTime
  status         ActiveProtocolStatus     @default(ACTIVE)
  doses          ProtocolDose[]
  drugLinks      ActiveProtocolDrugLink[]

  @@index([kittenId])
  @@index([protocolId])
  @@index([activatedById])
}

model ProtocolDose {
  id               Int            @id @default(autoincrement())
  activeProtocolId Int
  activeProtocol   ActiveProtocol @relation(fields: [activeProtocolId], references: [id], onDelete: Cascade)
  protocolDrugId   Int
  protocolDrug     ProtocolDrug   @relation(fields: [protocolDrugId], references: [id], onDelete: Restrict)
  scheduledDate    DateTime
  doseNumberInDay  Int
  status           DoseStatus     @default(SCHEDULED)
  administeredAt   DateTime?
  administeredById Int?
  administeredBy   User?          @relation("ProtocolDoseAdministeredBy", fields: [administeredById], references: [id], onDelete: SetNull)
  medicationId     Int?
  medication       Medication?    @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  vaccineId        Int?
  vaccine          Vaccine?       @relation(fields: [vaccineId], references: [id], onDelete: SetNull)
  notes            String         @default("")

  @@unique([activeProtocolId, protocolDrugId, scheduledDate, doseNumberInDay])
  @@index([activeProtocolId])
  @@index([protocolDrugId])
  @@index([administeredById])
  @@index([status, scheduledDate])
  @@index([medicationId])
  @@index([vaccineId])
}

// Tracks the single "course" Medication row created for a MEDICATION +
// COURSE ProtocolDrug when its ActiveProtocol is activated, so that
// markProtocolDoseGiven can detect the record already exists and avoid
// creating a duplicate Medication for every dose in the course.
model ActiveProtocolDrugLink {
  id               Int            @id @default(autoincrement())
  activeProtocolId Int
  activeProtocol   ActiveProtocol @relation(fields: [activeProtocolId], references: [id], onDelete: Cascade)
  protocolDrugId   Int
  protocolDrug     ProtocolDrug   @relation(fields: [protocolDrugId], references: [id], onDelete: Restrict)
  medicationId     Int
  medication       Medication     @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([activeProtocolId, protocolDrugId])
  @@index([activeProtocolId])
  @@index([protocolDrugId])
  @@index([medicationId])
}

model Settings {
  id                            Int     @id @default(1)
  orgName                       String  @default("Pawsitive Transformations")
  orgEin                        String  @default("42-3678960")
  // Org logo for document (PDF) headers only - separate from the public
  // site's logo, which is a static asset in PublicLogo.jsx and is
  // intentionally not sourced from here.
  orgLogoUrl                    String  @default("")
  // Rescue's "authorized representative" signature - applied automatically
  // to every contract's generated PDF at signing time as a second signature
  // block, alongside (not replacing) the foster/adopter's own live-drawn
  // signature. Same base64-data-URL storage pattern as orgLogoUrl.
  orgSignatureUrl               String  @default("")
  contactPhone                  String  @default("(951) 830-1825")
  contactEmail                  String  @default("hello@pawsitivetransformations.org")
  contactAddress                String  @default("12523 Limonite, Suite 440412\nMira Loma, CA 91752\nRiverside County")
  missionStatement              String  @default("")
  defaultDonationAmount         Int     @default(50)
  amazonWishlistUrl             String  @default("")
  chewyWishlistUrl              String  @default("")
  facebookUrl                   String  @default("")
  instagramUrl                  String  @default("")
  socialPostingEnabled          Boolean @default(false)
  facebookPageId                String  @default("")
  facebookPageAccessToken       String  @default("")
  instagramBusinessAccountId    String  @default("")
  groqApiKey                    String  @default("") @map("xaiApiKey")
  groqModel                     String  @default("llama-3.3-70b-versatile") @map("grokModel")
  aiEnabled                     Boolean @default(true)
  emailsEnabled                 Boolean @default(false)
  smtpHost                      String  @default("")
  smtpPort                      Int     @default(587)
  smtpSecure                    Boolean @default(false)
  smtpUser                      String  @default("")
  smtpPass                      String  @default("")
  fromEmail                     String  @default("")
  fromName                      String  @default("")
  adminNotifyEmail              String  @default("")
  donationWidgetCode            String  @default("")
  donatePageLive                Boolean @default(false)
  showCurrentPetsOnAdoptionForm Boolean @default(false)
  paypalLink                    String  @default("")
  stripeLink                    String  @default("")
  venmoQrCodeUrl                String  @default("")
  venmoHandle                   String  @default("")
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  category    String   @default("General")
  subject     String
  bodyHtml    String   @default("")
  bodyText    String   @default("")
  description String   @default("")
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailLog {
  id                Int      @id @default(autoincrement())
  templateKey       String
  toEmail           String
  subject           String
  status            String
  provider          String   @default("smtp")
  externalMessageId String   @default("")
  errorMessage      String   @default("")
  relatedType       String   @default("")
  relatedId         Int?
  createdAt         DateTime @default(now())
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String
  category    String
  amount      Float
  description String   @default("")
  donorName   String   @default("")
  donorEmail  String   @default("")
  externalId  String?  @unique
  date        DateTime
  kittenId    Int?
  kitten      Kitten?  @relation(fields: [kittenId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([type, date])
}

// CR-109: a wishlist row is one retailer link belonging to a NAMED list.
// `groupName` is what makes multiple named lists possible ("General Supplies",
// "TNR / Colony", ...), each holding an Amazon and/or Chewy and/or Walmart
// link. The uniqueness key includes groupName so the same retailer can appear
// once per named list rather than only once per owner.
model Wishlist {
  id        Int               @id @default(autoincrement())
  ownerType WishlistOwnerType
  ownerId   Int
  groupName String            @default("General Supplies")
  sortOrder Int               @default(0)
  retailer  WishlistRetailer
  url       String
  label     String            @default("")
  updatedAt DateTime          @updatedAt

  @@unique([ownerType, ownerId, groupName, retailer])
  @@index([ownerType, ownerId])
}

model SocialPost {
  id            Int              @id @default(autoincrement())
  body          String           @default("")
  imageUrl      String           @default("")
  platforms     String[]         @default([])
  scheduledFor  DateTime?
  status        SocialPostStatus @default(DRAFT)
  postedAt      DateTime?
  deliveryLog   String           @default("")
  attemptCount  Int              @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, scheduledFor])
  @@map("social_posts")
}
