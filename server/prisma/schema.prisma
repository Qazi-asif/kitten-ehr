generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActiveProtocolStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum WishlistOwnerType {
  ORG
  FOSTER
  KITTEN
}

enum WishlistRetailer {
  AMAZON
  CHEWY
  WALMART
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  POSTED
}

enum DoseStatus {
  SCHEDULED
  MISSED
  GIVEN
}

model Litter {
  id         Int      @id @default(autoincrement())
  name       String
  intakeDate DateTime
  notes      String   @default("")
  kittens    Kitten[]
}

model Foster {
  id               Int         @id @default(autoincrement())
  name             String
  phone            String
  email            String
  address          String
  emergencyContact String      @default("")
  experienceLevel  String      @default("")
  capabilityFlags  String      @default("")
  maxKittens       Int         @default(0)
  photoUrl         String?
  notes            String      @default("")
  createdAt        DateTime    @default(now())
  currentKittens   Kitten[]    @relation("CurrentFoster")
  placements       Placement[]
}

model Kitten {
  id              Int              @id @default(autoincrement())
  name            String
  litterId        Int?
  litter          Litter?          @relation(fields: [litterId], references: [id], onDelete: SetNull)
  status          String           @default("In Foster Care")
  rescueStory     String           @default("")
  dateOfBirth     DateTime?
  sex             String           @default("")
  fixedStatus     String           @default("")
  breed           String
  color           String           @default("")
  fivFelvStatus   String?
  specialNeeds    String?
  microchipNumber String           @default("")
  primaryPhotoUrl String?
  intakeDate      DateTime?
  intakeSource    String           @default("")
  notes           String           @default("")
  internalNotes   String           @default("")
  isListedOnWebsite Boolean        @default(false)
  websiteFeaturedComment String     @default("")
  publishTargets  String[]         @default([])
  amazonWishlistUrl  String?
  walmartWishlistUrl String?
  chewyWishlistUrl   String?
  currentFosterId Int?
  currentFoster   Foster?          @relation("CurrentFoster", fields: [currentFosterId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  placements      Placement[]
  weightLogs      WeightLog[]
  vaccines        Vaccine[]
  medications     Medication[]
  vetAppointments VetAppointment[]
  documents       Document[]
  sponsorships    Sponsorship[]
  updates         Update[]
  transactions    Transaction[]
  contracts       Contract[]
  activeProtocols ActiveProtocol[]
  eventCats       EventCats[]

  @@index([status])
  @@index([litterId])
  @@index([currentFosterId])
  @@index([status, createdAt])
}

model Update {
  id                Int      @id @default(autoincrement())
  kittenId          Int
  kitten            Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  content           String
  isPublic          Boolean  @default(false)
  platformList      String   @default("")
  publishTargets    String[] @default([])
  socialDeliveryLog String   @default("")
  createdAt         DateTime @default(now())

  @@index([kittenId])
  @@index([kittenId, createdAt])
}

model Sponsorship {
  id          Int      @id @default(autoincrement())
  kittenId    Int
  kitten      Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  sponsorName String
  amount      Float
  tier        String
  createdAt   DateTime @default(now())

  @@index([kittenId])
}

model Placement {
  id            Int       @id @default(autoincrement())
  kittenId      Int
  kitten        Kitten    @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  fosterId      Int
  foster        Foster    @relation(fields: [fosterId], references: [id], onDelete: Restrict)
  intakeDate    DateTime
  dischargeDate DateTime?
  dischargeType String?
  notes         String    @default("")

  @@index([kittenId])
  @@index([fosterId])
}

model WeightLog {
  id          Int      @id @default(autoincrement())
  kittenId    Int
  kitten      Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  date        DateTime
  weightOz    Float    @default(0)
  weightGrams Float    @default(0)
  loggedBy    String   @default("")
  notes       String   @default("")

  @@index([kittenId, date])
}

model Vaccine {
  id             Int      @id @default(autoincrement())
  kittenId       Int
  kitten         Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  type           String
  dateGiven      DateTime
  nextDueDate    DateTime?
  lotNumber      String   @default("")
  manufacturer   String   @default("")
  administeredBy String   @default("")
  notes          String   @default("")

  @@index([kittenId])
}

model Medication {
  id        Int       @id @default(autoincrement())
  kittenId  Int
  kitten    Kitten    @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  name      String
  dose      String    @default("")
  frequency String    @default("")
  route     String    @default("")
  condition String    @default("")
  startDate DateTime
  endDate   DateTime?
  status    String    @default("Active")
  notes     String    @default("")

  @@index([kittenId])
}

model VetAppointment {
  id           Int       @id @default(autoincrement())
  kittenId     Int
  kitten       Kitten    @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  date         DateTime
  clinic       String    @default("")
  vetName      String    @default("")
  reason       String    @default("")
  apptType     String    @default("")
  diagnosis    String    @default("")
  treatment    String    @default("")
  followUpDate DateTime?
  notes        String    @default("")

  @@index([kittenId])
}

model Document {
  id             Int      @id @default(autoincrement())
  kittenId       Int
  kitten         Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  docType        String   @default("")
  description    String   @default("")
  isPrimaryPhoto Boolean  @default(false)
  sortOrder      Int      @default(0)
  uploadedAt     DateTime @default(now())

  @@index([kittenId])
  @@index([kittenId, isPrimaryPhoto])
}

model Application {
  id               Int                 @id @default(autoincrement())
  type             String
  status           String              @default("New")
  statusNotes      String              @default("")
  statusUpdatedAt  DateTime?
  kittenOfInterest String?
  formData         String              @default("{}")
  rejectionReason  String?
  rejectionNotes   String?
  rejectedById     Int?
  rejectedAt       DateTime?
  rejectedBy       User?               @relation("ApplicationRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  contracts        Contract[]
  uploads          ApplicationUpload[]

  @@index([rejectedById])
}

enum ContractType {
  FOSTER
  ADOPTION
}

enum ContractStatus {
  SENT
  SIGNED
  VOID
}

model Contract {
  id               Int            @id @default(autoincrement())
  type             ContractType
  signerName       String
  signerEmail      String
  kittenName       String         @default("")
  kittenId         Int?
  kitten           Kitten?        @relation(fields: [kittenId], references: [id], onDelete: SetNull)
  applicationId    Int?
  application      Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  documentVersion  String
  signedPdfUrl     String         @default("")
  signatureAudit   String         @default("{}")
  status           ContractStatus @default(SENT)
  signedAt         DateTime?
  createdAt        DateTime       @default(now())

  @@index([applicationId])
  @@index([kittenId])
  @@index([kittenName])
  @@index([status])
  @@index([signerEmail])
  @@index([signedAt])
  @@index([createdAt])
}

enum FosterOnboardingStatus {
  APPLIED
  SCREENING
  APPROVED
  ACTIVE
  DECLINED
  WITHDRAWN
}

model FosterOnboarding {
  id              Int                    @id @default(autoincrement())
  applicantName   String
  applicantEmail  String
  status          FosterOnboardingStatus @default(APPLIED)
  notes           String                 @default("")
  createdAt       DateTime               @default(now())
  checklistItems  OnboardingChecklist[]

  @@index([status])
  @@index([applicantEmail])
}

model OnboardingChecklist {
  id              Int              @id @default(autoincrement())
  onboardingId    Int
  onboarding      FosterOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  stepKey         String
  label           String
  isComplete      Boolean          @default(false)
  completedAt     DateTime?
  completedBy     Int?
  completedByUser User?            @relation("ChecklistCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)

  @@index([onboardingId])
  @@index([completedBy])
  @@unique([onboardingId, stepKey])
}

model ApplicationUpload {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String      @default("")
  docLabel      String      @default("")
  fileUrl       String
  fileType      String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model Content {
  id             Int                 @id @default(autoincrement())
  title          String
  slug           String              @unique
  body           String              @default("")
  category       String              @default("education")
  isRequired     Boolean             @default(false)
  publishTargets String[]            @default([])
  createdAt      DateTime            @default(now())
  completions    ContentCompletion[]
}

model ContentCompletion {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId   Int
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

model Event {
  id             Int         @id @default(autoincrement())
  title          String
  slug           String      @unique
  date           DateTime
  endDate        DateTime?
  location       String      @default("")
  description    String      @default("")
  isPublic       Boolean     @default(false)
  status         String      @default("DRAFT")
  internalNotes  String?
  publishTargets String[]    @default([])
  eventCats      EventCats[]
  rsvps          EventRSVP[]
}

model EventRSVP {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model EventCats {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kittenId  Int
  kitten    Kitten   @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())
  notes     String?

  @@unique([eventId, kittenId])
  @@index([eventId])
  @@index([kittenId])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String           @default("")
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id       Int              @id @default(autoincrement())
  key      String           @unique
  label    String
  module   String           @default("")
  roles    RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                    Int                   @id @default(autoincrement())
  email                 String                @unique
  passwordHash          String
  firstName             String
  lastName              String
  isActive              Boolean               @default(true)
  roleId                Int
  role                  Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  fosterId              Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lastLoginAt           DateTime?
  rejectedApplications  Application[]         @relation("ApplicationRejectedBy")
  completedChecklistItems OnboardingChecklist[] @relation("ChecklistCompletedBy")
  contentCompletions    ContentCompletion[]
  activatedProtocols    ActiveProtocol[]      @relation("ProtocolActivatedBy")
  administeredProtocolDoses ProtocolDose[]      @relation("ProtocolDoseAdministeredBy")
}

model Protocol {
  id              Int              @id @default(autoincrement())
  name            String
  description     String           @default("")
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  drugs           ProtocolDrug[]
  activeProtocols ActiveProtocol[]
}

model ProtocolDrug {
  id               Int            @id @default(autoincrement())
  protocolId       Int
  protocol         Protocol       @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  drugName         String
  dosage           String         @default("")
  route            String         @default("")
  startDayOffset   Int
  endDayOffset     Int
  frequencyPerDay  Int
  instructions     String         @default("")
  sortOrder        Int            @default(0)
  doses            ProtocolDose[]

  @@index([protocolId])
}

model ActiveProtocol {
  id              Int                  @id @default(autoincrement())
  protocolId      Int
  protocol        Protocol             @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  kittenId        Int
  kitten          Kitten               @relation(fields: [kittenId], references: [id], onDelete: Cascade)
  activatedById   Int
  activatedBy     User                 @relation("ProtocolActivatedBy", fields: [activatedById], references: [id], onDelete: Restrict)
  activationDate  DateTime
  status          ActiveProtocolStatus @default(ACTIVE)
  doses           ProtocolDose[]

  @@index([kittenId])
  @@index([protocolId])
  @@index([activatedById])
}

model ProtocolDose {
  id                Int          @id @default(autoincrement())
  activeProtocolId  Int
  activeProtocol    ActiveProtocol @relation(fields: [activeProtocolId], references: [id], onDelete: Cascade)
  protocolDrugId    Int
  protocolDrug      ProtocolDrug @relation(fields: [protocolDrugId], references: [id], onDelete: Restrict)
  scheduledDate     DateTime
  doseNumberInDay   Int
  status            DoseStatus   @default(SCHEDULED)
  administeredAt    DateTime?
  administeredById  Int?
  administeredBy    User?        @relation("ProtocolDoseAdministeredBy", fields: [administeredById], references: [id], onDelete: SetNull)
  notes             String       @default("")

  @@unique([activeProtocolId, protocolDrugId, scheduledDate, doseNumberInDay])
  @@index([activeProtocolId])
  @@index([protocolDrugId])
  @@index([administeredById])
}

model Settings {
  id                    Int     @id @default(1)
  orgName               String  @default("Pawsitive Transformations")
  orgEin                String  @default("42-3678960")
  contactPhone          String  @default("(951) 830-1825")
  contactEmail          String  @default("hello@pawsitivetransformations.org")
  contactAddress        String  @default("12523 Limonite, Suite 440412\nMira Loma, CA 91752\nRiverside County")
  missionStatement      String  @default("")
  defaultDonationAmount Int     @default(50)
  amazonWishlistUrl     String  @default("")
  chewyWishlistUrl      String  @default("")
  facebookUrl                String  @default("")
  instagramUrl               String  @default("")
  socialPostingEnabled       Boolean @default(false)
  facebookPageId             String  @default("")
  facebookPageAccessToken    String  @default("")
  instagramBusinessAccountId String  @default("")
  groqApiKey                 String  @default("") @map("xaiApiKey")
  groqModel                  String  @default("llama-3.3-70b-versatile") @map("grokModel")
  aiEnabled                  Boolean @default(true)
  emailsEnabled              Boolean @default(false)
  smtpHost              String  @default("")
  smtpPort              Int     @default(587)
  smtpSecure            Boolean @default(false)
  smtpUser              String  @default("")
  smtpPass              String  @default("")
  fromEmail             String  @default("")
  fromName              String  @default("")
  adminNotifyEmail      String  @default("")
  donationWidgetCode    String  @default("")
  paypalLink            String  @default("")
  stripeLink            String  @default("")
  venmoQrCodeUrl        String  @default("")
  venmoHandle           String  @default("")
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  category    String   @default("General")
  subject     String
  bodyHtml    String   @default("")
  bodyText    String   @default("")
  description String   @default("")
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailLog {
  id                Int      @id @default(autoincrement())
  templateKey       String
  toEmail           String
  subject           String
  status            String
  provider          String   @default("smtp")
  externalMessageId String   @default("")
  errorMessage      String   @default("")
  relatedType       String   @default("")
  relatedId         Int?
  createdAt         DateTime @default(now())
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String
  category    String
  amount      Float
  description String   @default("")
  donorName   String   @default("")
  donorEmail  String   @default("")
  date        DateTime
  kittenId    Int?
  kitten      Kitten?  @relation(fields: [kittenId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Wishlist {
  id        Int               @id @default(autoincrement())
  ownerType WishlistOwnerType
  ownerId   Int
  retailer  WishlistRetailer
  url       String
  label     String            @default("")
  updatedAt DateTime          @updatedAt

  @@unique([ownerType, ownerId, retailer])
  @@index([ownerType, ownerId])
}

model SocialPost {
  id           Int              @id @default(autoincrement())
  body         String           @default("")
  imageUrl     String           @default("")
  platforms    String[]         @default([])
  scheduledFor DateTime?
  status       SocialPostStatus @default(DRAFT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("social_posts")
}
