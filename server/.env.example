# Hostinger Node app → Environment Variables (never commit real values).
# Operator notes and verification steps: ../hostinger-operations.md
#
# Use Neon's *pooled* connection string (hostname contains "-pooler").
# The app uses the Rust-free Prisma client + node-pg pool (default max 8).
# Override with DATABASE_POOL_MAX if Hostinger/Neon needs a different size.
# connect_timeout bounds stalled TCP handshakes to Neon (seconds).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require&connect_timeout=10"
# DATABASE_POOL_MAX=8
JWT_SECRET="replace-with-a-long-random-secret"
# Both feed the CORS allow-list (server/src/utils/corsOrigins.js) on top of the
# hard-coded production hosts, and PUBLIC_SITE_URL is also the base for emailed
# links and social/share asset URLs. In production set them to
# https://pawsitivetransformations.org (no trailing slash).
CLIENT_URL="http://localhost:5173"
PUBLIC_SITE_URL="http://localhost:5173"
# Optional comma-separated extra origins to allow, for a temporary host.
# CLIENT_URLS=""

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Setting these three variables enables email automatically on first boot.
# Gmail: use an App Password (Google Account → Security → App Passwords).
# Host = smtp.gmail.com, Port = 587, leave SMTP_SECURE unset (STARTTLS is used).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# SMTP_SECURE="false"   # set to "true" only if using port 465 direct-SSL
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
# ──────────────────────────────────────────────────────────────────────────────

# ─── Scheduled social posts ───────────────────────────────────────────────────
# The scheduler runs in-process and is ON by default (60s poll). Both of these are
# optional; set the first to "false" only to stop scheduled posts going out.
# SOCIAL_SCHEDULER_ENABLED="false"
# SOCIAL_SCHEDULER_INTERVAL_MS="60000"
#
# Optional: enables GET/POST /api/cron/social-posts as an external trigger for one
# scheduler pass. Unset means that endpoint returns 503; scheduling still works.
# CRON_SECRET=""
# ──────────────────────────────────────────────────────────────────────────────

# Optional: automatic Facebook/Instagram posting (Settings → Organization can also store these)
SOCIAL_POSTING_ENABLED="false"
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# AI Copywriter — Groq (https://console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Givebutter webhook signature (Settings → Integrations → Webhooks). Required in production.
GIVEBUTTER_WEBHOOK_SECRET=""

# Client override only (optional). Prefer Admin → Settings → Enable Donations & Test.
# VITE_DONATE_LIVE=true

# Object storage for uploads (S3 or Cloudflare R2). Required on Vercel to avoid base64 blobs in the DB.
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2 example: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# Public CDN base URL for uploaded files, e.g. https://pub-xxx.r2.dev or https://cdn.example.com
S3_PUBLIC_URL=""
